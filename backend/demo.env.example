# Copy to backend/.env.demo and fill with a SEPARATE Supabase demo project.
# The demo seeder reads this file only and never falls back to backend/.env.
APP_ENV=demo
DEMO_SEED_CONFIRM=SEED_AGRI_MENYA_DEMO
DEMO_SUPABASE_URL=https://YOUR_DEMO_PROJECT_REF.supabase.co
DEMO_SUPABASE_PROJECT_REF=YOUR_DEMO_PROJECT_REF
DEMO_SUPABASE_SERVICE_ROLE_KEY=YOUR_DEMO_SERVICE_ROLE_KEY

# Runtime settings for pointing the local API at the same demo database.
SUPABASE_URL=https://YOUR_DEMO_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_DEMO_SERVICE_ROLE_KEY
USER_API_KEY=replace-with-a-random-demo-api-key-at-least-32-characters
JWT_SECRET=replace-with-a-random-demo-jwt-secret-at-least-32-characters
WHATSAPP_MODE=mock
ALLOW_UNSIGNED_WEBHOOKS_IN_MOCK=true
ALLOWED_ORIGINS=http://localhost:8501
ALLOWED_HOSTS=localhost,127.0.0.1
