# Copy to .env.production on the deployment host. Replace every placeholder.
# Keep this file and all production secrets out of source control and images.

APP_ENV=production

# Public DNS names pointing to the Docker host. Caddy obtains and renews HTTPS certificates.
APP_DOMAIN=app.example.org
API_DOMAIN=api.example.org

# Supabase server-side credentials. Do not put the service-role key in the frontend.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=
SUPABASE_SERVICE_ROLE_KEY=replace-with-supabase-service-role-key

# Generate independent random values of at least 32 characters for each environment.
USER_API_KEY=replace-with-a-random-user-api-key-at-least-32-characters
JWT_SECRET=replace-with-a-different-random-jwt-secret-at-least-32-characters
JWT_ALGORITHM=HS256

ALLOWED_ORIGINS=https://app.example.org
ALLOWED_HOSTS=api.example.org,app.example.org,api,127.0.0.1

# Reset/verification links must point to the public frontend over HTTPS.
ADMIN_PASSWORD_RESET_URL=https://app.example.org/Admin
COMMUNITY_PASSWORD_RESET_URL=https://app.example.org/Community
# Resend sends over HTTPS, which works on hosts that restrict outbound SMTP.
# Verify your sending domain in Resend, then create an API key in that account.
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM="Agri-Menya <no-reply@mail.example.org>"
# SMTP remains available as an alternative when the host permits outbound SMTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_SSL=false
SMTP_STARTTLS=true
DEFAULT_NOTIFICATION_EMAIL=
DEFAULT_NOTIFICATION_PHONE=

# Optional Google Community sign-in. Register this exact redirect URI in Google Cloud.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://app.example.org/community/auth/google/callback
COMMUNITY_GOOGLE_CALLBACK_URL=https://app.example.org/Community
# OAuth is reverse-proxied through the app origin; leave the cookie domain unset.
COMMUNITY_GOOGLE_HANDOFF_COOKIE_DOMAIN=

# Supabase Storage bucket used for private community field-report photos.
COMMUNITY_PHOTO_BUCKET=community-field-reports

# AI services are optional; leave credentials empty to use grounded local fallbacks.
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_VISION_MODEL=qwen/qwen3.8-27b
LLM_API_KEY=
LLM_MODEL=claude-sonnet-4-6

# Keep WhatsApp in mock mode until Meta production setup and end-to-end checks pass.
WHATSAPP_MODE=mock
WHATSAPP_PUBLIC_CHAT_ENABLED=false
WHATSAPP_GRAPH_VERSION=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_PUBLIC_NUMBER=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_DEFAULT_COUNTRY_CODE=250
WHATSAPP_DAILY_CAP=200
ALLOW_UNSIGNED_WEBHOOKS_IN_MOCK=false

# Optional legacy SMS settings.
TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_PHONE=
TWILIO_WHATSAPP_NUMBER=

MAX_UPLOAD_SIZE_MB=10
