# Copy to .env and replace each placeholder with values from your providers.
# Never commit the real .env file. Keep service-role and provider secrets server-side.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-supabase-publishable-key
SUPABASE_SERVICE_ROLE_KEY=
# PostgreSQL connection string used only by the optional /health/deep probe.
SUPABASE_DB_URL=

# Local development defaults
APP_ENV=development
ALLOWED_ORIGINS=http://127.0.0.1:8501,http://localhost:8501
ALLOWED_HOSTS=127.0.0.1,localhost

# Optional AI provider. Groq is the default; create a GroqCloud API key and
# place it in the local .env file. The assistant falls back to grounded local
# answers if this key is empty or the provider is unavailable.
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Vision model used for preliminary crop-photo triage (requires a Groq vision-enabled model).
GROQ_VISION_MODEL=qwen/qwen3.8-27b

# Optional legacy Anthropic provider; used only when LLM_PROVIDER=anthropic.
LLM_API_KEY=
LLM_MODEL=claude-sonnet-4-6

# Use a private random value of at least 32 characters. Required for community sessions
# in every environment and for production user API access.
USER_API_KEY=replace-with-a-random-user-key
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_ALGORITHM=HS256

# Optional notification providers
EMAIL_PROVIDER=smtp
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_SSL=false
SMTP_STARTTLS=true
EMAIL_FROM=
COMMUNITY_PASSWORD_RESET_URL=http://localhost:8501/Community
# Optional Google OAuth for Farmer Community. Register the backend callback URI
# exactly in the Google Cloud OAuth client. Leave both credentials blank to hide the button.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8002/community/auth/google/callback
COMMUNITY_GOOGLE_CALLBACK_URL=http://localhost:8501/Community
# Set to the shared parent domain when the backend and frontend use different subdomains.
COMMUNITY_GOOGLE_HANDOFF_COOKIE_DOMAIN=
# Local development URL. Replace with the public HTTPS Admin page URL in production.
ADMIN_PASSWORD_RESET_URL=http://localhost:8501/Admin
DEFAULT_NOTIFICATION_EMAIL=
DEFAULT_NOTIFICATION_PHONE=
TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_PHONE=
TWILIO_WHATSAPP_NUMBER=

# WhatsApp Cloud API (mock mode works offline; set graph version from Meta docs for live mode)
WHATSAPP_MODE=mock
WHATSAPP_PUBLIC_CHAT_ENABLED=false
WHATSAPP_GRAPH_VERSION=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_PUBLIC_NUMBER=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_DEFAULT_COUNTRY_CODE=250
WHATSAPP_DAILY_CAP=200
ALLOW_UNSIGNED_WEBHOOKS_IN_MOCK=false

MAX_UPLOAD_SIZE_MB=10
#$C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe" -Command ".\\.venv\\Scripts\\python.exe -m uvicorn app.main:app --host 127.0.0.1 --port 8000
