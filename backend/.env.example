# Copy this file to .env and fill in real values.
# Never commit the real .env file.

# Use the project URL from Supabase.
SUPABASE_URL=https://<project-ref>.supabase.co

# Use the project anon or publishable key for client-side interactions.
# For backend/admin operations, prefer the service-role secret if you need full DB writes.
SUPABASE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Used for CORS - the deployed frontend URL(s), comma-separated
ALLOWED_ORIGINS=http://localhost:8501

# Optional: LLM provider key for the AI assistant (Pillar: Communication/Chat)
LLM_API_KEY=

APP_ENV=development
